{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-learning-os.local/schemas/assessment.schema.json",
  "title": "Japanese Learning OS practice assessment",
  "type": "object",
  "required": ["version", "title", "questions"],
  "properties": {
    "version": { "type": "string" },
    "title": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "target", "prompt", "choices", "answer", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^q_[0-9]{3}$" },
          "category": { "enum": ["grammar", "vocabulary", "kanji", "reading"] },
          "target": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "choices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answer": { "type": "integer", "minimum": 0 },
          "explanation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
